# Copy to .env for local services. Never commit real values.
SENTINEL_ROOT=.
# Directory holding hidden scenarios (organizer machines only).
SENTINEL_PRIVATE_SCENARIOS=
# Bearer token required for leaderboard write endpoints.
SENTINEL_ADMIN_TOKEN=change-me-locally
# Optional: local model path for the Hugging Face adapter (offline, read-only mount).
SENTINEL_HF_MODEL_PATH=
