# Example unit for a single evaluation host. Adjust paths and the token file before use.
[Unit]
Description=SENTINEL leaderboard
After=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel-bench
EnvironmentFile=/etc/sentinel/leaderboard.env
ExecStart=/opt/sentinel-bench/.venv/bin/sentinel serve leaderboard --db /var/lib/sentinel/leaderboard.sqlite3 --host 127.0.0.1 --port 8090
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sentinel
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
